# Server-side only. Never prefix either value with VITE_.
# Set both Dograh values to call the API Trigger attached to the Crewmind agent.
DOGRAH_API_KEY=
DOGRAH_TRIGGER_UUID=

# Optional guarded n8n path. Used only when Dograh values above are unset.
CREWMIND_DEMO_WEBHOOK_URL=
CREWMIND_DEMO_WEBHOOK_TOKEN=
