{
  "name": "crewmind-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "preview": "tsx scripts/serve.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test --project=chromium",
    "test:visual": "tsx scripts/visual-crewmind.ts",
    "audit": "tsx scripts/audit.ts"
  },
  "dependencies": {
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "cheerio": "^1.1.2",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
